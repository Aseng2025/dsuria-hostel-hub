rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'mhybsi91@gmail.com';
    }

    function isActiveAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function assignedToStudentHostel(studentUid) {
      return isActiveAdmin()
        && firestore.get(/databases/(default)/documents/studentProfiles/$(studentUid)).data.hostelId
          in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.hostelIds;
    }

    match /student-profile-photos/{studentUid}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == studentUid
        || isSuperAdmin()
        || assignedToStudentHostel(studentUid)
      );

      allow create, update: if signedIn()
        && request.auth.uid == studentUid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if signedIn() && (
        request.auth.uid == studentUid || isSuperAdmin()
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
