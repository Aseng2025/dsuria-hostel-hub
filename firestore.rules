
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // HELPER FUNCTIONS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvedPath(email) {
      return /databases/$(database)/documents/approvedUsers/$(email);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'mhybsi91@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isActiveUser() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'admin';
    }

    function isStudent() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'student';
    }

    function isApprovedEmail(email) {
      return signedIn()
        && request.auth.token.email == email
        && exists(approvedPath(email))
        && get(approvedPath(email)).data.status == 'active';
    }

    function validStudentHostel(hostelId) {
      return hostelId is string
        && exists(/databases/$(database)/documents/hostels/$(hostelId))
        && get(/databases/$(database)/documents/hostels/$(hostelId)).data.status == 'active';
    }

    function assignedToHostel(hostelId) {
      return isAdmin()
        && hostelId is string
        && hostelId in userData(request.auth.uid).hostelIds;
    }

    function canReadStudentRecord(studentUid) {
      return signedIn()
        && (
          request.auth.uid == studentUid
          || isSuperAdmin()
          || (
            isAdmin()
            && exists(/databases/$(database)/documents/studentProfiles/$(studentUid))
            && assignedToHostel(
              get(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.hostelId
            )
          )
        );
    }

    function validProfileData() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'fullName',
        'phone',
        'programme',
        'hostelId',
        'hostelName',
        'room',
        'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.fullName is string
      && request.resource.data.fullName.size() > 0
      && request.resource.data.fullName.size() <= 100
      && request.resource.data.phone is string
      && request.resource.data.programme is string
      && request.resource.data.hostelId is string
      && request.resource.data.hostelName is string
      && request.resource.data.room is string
      && validStudentHostel(request.resource.data.hostelId);
    }

    function validEmergencyData() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'studentEmail',
        'contacts',
        'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.studentEmail == request.auth.token.email
      && request.resource.data.contacts is list
      && request.resource.data.contacts.size() == 2;
    }

    // =========================================
    // APPROVED USERS
    // Super Admin manages approved accounts
    // =========================================

    match /approvedUsers/{email} {

      allow read: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.token.email == email
        );

      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================
    // USERS
    // User can read own account.
    // Super Admin manages all accounts.
    // =========================================

    match /users/{uid} {

      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (
            request.auth.token.email == 'mhybsi91@gmail.com'
            && request.resource.data.role == 'superadmin'
            && request.resource.data.status == 'active'
          )
          ||
          (
            isApprovedEmail(request.auth.token.email)
            && request.resource.data.role ==
              get(approvedPath(request.auth.token.email)).data.role
            && request.resource.data.status == 'active'
            && request.resource.data.hostelIds ==
              get(approvedPath(request.auth.token.email)).data.hostelIds
          )
        );

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLoginAt', 'hostelIds'])
          && request.resource.data.hostelIds ==
            get(approvedPath(request.auth.token.email)).data.hostelIds
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // HOSTELS
    // Students can read active hostels.
    // Super Admin manages hostel records.
    // =========================================

    match /hostels/{hostelId} {

      allow read: if isSuperAdmin()
        || (
          isActiveUser()
          && resource.data.status == 'active'
        );

      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================
    // STUDENT PROFILES
    // Students manage their own profile.
    // Admin reads only assigned hostel records.
    // =========================================

    match /studentProfiles/{studentUid} {

      allow read: if canReadStudentRecord(studentUid);

      allow create: if signedIn()
        && request.auth.uid == studentUid
        && isStudent()
        && validProfileData();

      allow update: if signedIn()
        && request.auth.uid == studentUid
        && isStudent()
        && validProfileData();

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // EMERGENCY CONTACTS
    // Student manages own emergency contacts.
    // Admin reads records for assigned hostels.
    // =========================================

    match /emergencyContacts/{studentUid} {

      allow read: if canReadStudentRecord(studentUid);

      allow create, update: if signedIn()
        && request.auth.uid == studentUid
        && isStudent()
        && validEmergencyData();

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // ADMIN AUDIT LOGS
    // Super Admin only.
    // No update or delete permitted.
    // =========================================

    match /adminAuditLogs/{logId} {

      allow read: if isSuperAdmin();

      allow create: if isSuperAdmin()
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    // =========================================
    // DEFAULT DENY
    // All unspecified collections are protected.
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
