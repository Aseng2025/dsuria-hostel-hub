
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // HELPER FUNCTIONS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvedPath(userEmail) {
      return /databases/$(database)/documents/approvedUsers/$(userEmail);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && email() == 'mhybsi91@gmail.com';
    }

    function isActiveUser() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'admin';
    }

    function isStudent() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'student';
    }

    function isApprovedEmail(userEmail) {
      return signedIn()
        && email() == userEmail
        && exists(approvedPath(userEmail))
        && get(approvedPath(userEmail)).data.status == 'active';
    }

    function validStudentHostel(hostelId) {
      return hostelId is string
        && exists(/databases/$(database)/documents/hostels/$(hostelId))
        && get(/databases/$(database)/documents/hostels/$(hostelId)).data.status == 'active';
    }

    function assignedToHostel(hostelId) {
      return isAdmin()
        && hostelId is string
        && hostelId in userData(request.auth.uid).hostelIds;
    }

    function canReadStudentRecord(studentUid) {
      return signedIn()
        && (
          request.auth.uid == studentUid
          || isSuperAdmin()
          || (
            isAdmin()
            && exists(/databases/$(database)/documents/studentProfiles/$(studentUid))
            && assignedToHostel(
              get(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.hostelId
            )
          )
        );
    }

    function validApprovedUser() {
      return request.resource.data.keys().hasOnly([
        'role',
        'status',
        'hostelIds',
        'addedBy',
        'addedAt',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'role',
        'status',
        'hostelIds'
      ])
      && request.resource.data.role in ['admin', 'student']
      && request.resource.data.status in ['active', 'inactive']
      && request.resource.data.hostelIds is list
      && (
        (
          request.resource.data.role == 'admin'
          && request.resource.data.hostelIds.size() > 0
        )
        ||
        (
          request.resource.data.role == 'student'
          && request.resource.data.hostelIds.size() == 0
        )
      );
    }

    function validProfileData() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'fullName',
        'phone',
        'programme',
        'hostelId',
        'hostelName',
        'room',
        'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.fullName is string
      && request.resource.data.fullName.size() > 0
      && request.resource.data.fullName.size() <= 100
      && request.resource.data.phone is string
      && request.resource.data.programme is string
      && request.resource.data.hostelId is string
      && request.resource.data.hostelName is string
      && request.resource.data.room is string
      && validStudentHostel(request.resource.data.hostelId);
    }

    function validEmergencyData() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'studentEmail',
        'contacts',
        'updatedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.studentEmail == request.auth.token.email
      && request.resource.data.contacts is list
      && request.resource.data.contacts.size() == 2
      && request.resource.data.contacts[0].keys().hasOnly([
        'fullName', 'phone', 'relationship', 'address'
      ])
      && request.resource.data.contacts[1].keys().hasOnly([
        'fullName', 'phone', 'relationship', 'address'
      ])
      && request.resource.data.contacts[0].fullName is string
      && request.resource.data.contacts[0].phone is string
      && request.resource.data.contacts[0].relationship is string
      && request.resource.data.contacts[0].address is string
      && request.resource.data.contacts[1].fullName is string
      && request.resource.data.contacts[1].phone is string
      && request.resource.data.contacts[1].relationship is string
      && request.resource.data.contacts[1].address is string;
    }

    // =========================================
    // APPROVED USERS
    // =========================================

    match /approvedUsers/{userEmail} {

      allow read: if isSuperAdmin()
        || (
          signedIn()
          && email() == userEmail
        );

      allow create, update: if isSuperAdmin()
        && userEmail.matches('^[^@]+@[^@]+\\.[^@]+$')
        && validApprovedUser();

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // USERS
    // =========================================

    match /users/{uid} {

      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (
            isSuperAdmin()
            && request.resource.data.role == 'superadmin'
            && request.resource.data.status == 'active'
          )
          ||
          (
            isApprovedEmail(email())
            && request.resource.data.role ==
              get(approvedPath(email())).data.role
            && request.resource.data.status == 'active'
            && request.resource.data.hostelIds ==
              get(approvedPath(email())).data.hostelIds
          )
        );

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLoginAt', 'hostelIds'])
          && request.resource.data.hostelIds ==
            get(approvedPath(email())).data.hostelIds
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // HOSTELS
    // =========================================

    match /hostels/{hostelId} {

      allow read: if isSuperAdmin()
        || (
          isActiveUser()
          && resource.data.status == 'active'
        );

      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================
    // STUDENT PROFILES
    // =========================================

    match /studentProfiles/{studentUid} {

      allow read: if canReadStudentRecord(studentUid);

      allow create, update: if signedIn()
        && request.auth.uid == studentUid
        && isStudent()
        && validProfileData();

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // EMERGENCY CONTACTS
    // =========================================

    match /emergencyContacts/{studentUid} {

      allow read: if canReadStudentRecord(studentUid);

      allow create, update: if signedIn()
        && request.auth.uid == studentUid
        && isStudent()
        && validEmergencyData();

      allow delete: if isSuperAdmin();
    }

    // =========================================
    // ADMIN AUDIT LOGS
    // =========================================

    match /adminAuditLogs/{logId} {

      allow read: if isSuperAdmin();

      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'action',
          'targetEmail',
          'oldRole',
          'newRole',
          'reason',
          'performedBy',
          'performedByEmail',
          'createdAt'
        ])
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    // =========================================
    // DEFAULT DENY
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
