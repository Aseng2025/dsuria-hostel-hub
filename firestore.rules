rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasUser(uid) { return exists(userPath(uid)); }
    function userData(uid) { return get(userPath(uid)).data; }
    function email() { return request.auth.token.email.lower(); }
    function isSuper() {
      return signedIn()
        && request.auth.token.email_verified == true
        && email() == 'mhybsi91@gmail.com';
    }
    function isAdmin() {
      return isSuper() || (
        signedIn() && hasUser(request.auth.uid)
        && userData(request.auth.uid).role == 'admin'
        && userData(request.auth.uid).status == 'active'
      );
    }
    function isActiveUser() {
      return signedIn() && hasUser(request.auth.uid)
        && userData(request.auth.uid).status == 'active';
    }

    match /approvedUsers/{id} {
      allow read: if signedIn() && (id == email() || isAdmin());
      allow create, update: if isSuper()
        && id.matches('^[^@]+@[^@]+\\.[^@]+$')
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt', 'updatedAt'])
        && request.resource.data.role in ['student', 'admin'];
      allow delete: if isSuper();
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'status', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.email == email()
        && request.resource.data.status == 'active'
        && (
          (isSuper() && request.resource.data.role == 'superadmin')
          || (
            exists(/databases/$(database)/documents/approvedUsers/$(email()))
            && request.resource.data.role ==
              get(/databases/$(database)/documents/approvedUsers/$(email())).data.role
            && request.resource.data.role in ['student', 'admin']
          )
        );
      allow update: if isSuper()
        || (
          signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLoginAt'])
        );
      allow delete: if false;
    }

    match /studentProfiles/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && uid == request.auth.uid
        && isActiveUser()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'fullName', 'phone', 'programme', 'room', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.programme is string
        && request.resource.data.room is string;
      allow delete: if isSuper();
    }

    match /emergencyContacts/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && uid == request.auth.uid
        && isActiveUser()
        && request.resource.data.keys().hasOnly([
          'uid', 'studentEmail', 'contacts', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentEmail == email()
        && request.resource.data.contacts is list
        && request.resource.data.contacts.size() == 2
        && request.resource.data.contacts[0].keys().hasOnly([
          'fullName', 'phone', 'relationship', 'address'
        ])
        && request.resource.data.contacts[1].keys().hasOnly([
          'fullName', 'phone', 'relationship', 'address'
        ])
        && request.resource.data.contacts[0].fullName is string
        && request.resource.data.contacts[0].phone is string
        && request.resource.data.contacts[0].relationship is string
        && request.resource.data.contacts[0].address is string
        && request.resource.data.contacts[1].fullName is string
        && request.resource.data.contacts[1].phone is string
        && request.resource.data.contacts[1].relationship is string
        && request.resource.data.contacts[1].address is string;
      allow delete: if isSuper();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isSuper();
      allow create: if isSuper()
        && request.resource.data.keys().hasOnly([
          'action', 'targetEmail', 'oldRole', 'newRole', 'reason',
          'performedBy', 'performedByEmail', 'createdAt'
        ])
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == email();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
