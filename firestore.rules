rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Identity and role helpers
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvedPath(userEmail) {
      return /databases/$(database)/documents/approvedUsers/$(userEmail);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && email() == 'mhybsi91@gmail.com';
    }

    function isActiveUser() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'admin';
    }

    function isStudent() {
      return isActiveUser()
        && userData(request.auth.uid).role == 'student';
    }

    function isApprovedEmail(userEmail) {
      return signedIn()
        && email() == userEmail
        && exists(approvedPath(userEmail))
        && get(approvedPath(userEmail)).data.status == 'active';
    }

    function validStudentHostel(hostelId) {
      return hostelId is string
        && exists(/databases/$(database)/documents/hostels/$(hostelId))
        && get(/databases/$(database)/documents/hostels/$(hostelId)).data.status == 'active';
    }

    function assignedToHostel(hostelId) {
      return isAdmin()
        && hostelId is string
        && hostelId in userData(request.auth.uid).hostelIds;
    }

    function canReadStudentRecord(studentUid) {
      return signedIn()
        && (
          request.auth.uid == studentUid
          || isSuperAdmin()
          || (
            isAdmin()
            && exists(/databases/$(database)/documents/studentProfiles/$(studentUid))
            && assignedToHostel(
              get(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.hostelId
            )
          )
        );
    }

    // Approved account access
    function validApprovedUser() {
      return request.resource.data.keys().hasOnly([
          'role', 'status', 'hostelIds', 'addedBy', 'addedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['role', 'status', 'hostelIds'])
        && request.resource.data.role in ['admin', 'student']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.hostelIds is list
        && (
          (request.resource.data.role == 'admin' && request.resource.data.hostelIds.size() > 0)
          || (request.resource.data.role == 'student' && request.resource.data.hostelIds.size() == 0)
        );
    }

    // Student profile validation. Drafts may be incomplete; submissions may not.
    function validProfileShape(studentUid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'fullName', 'phone', 'programme', 'hostelId',
          'hostelName', 'room', 'updatedAt', 'approvalStatus', 'approvedBy',
          'approvedByEmail', 'approvedAt', 'rejectionReason', 'submittedAt',
          'submissionVersion', 'lastEditedBy', 'profilePhotoUrl', 'profilePhotoPath'
        ])
        && request.resource.data.uid == studentUid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.programme is string
        && request.resource.data.hostelId is string
        && request.resource.data.hostelName is string
        && request.resource.data.room is string
        && request.resource.data.approvalStatus in ['draft', 'pending', 'approved', 'rejected']
        && (!('profilePhotoUrl' in request.resource.data) || request.resource.data.profilePhotoUrl is string)
        && (!('profilePhotoPath' in request.resource.data) || request.resource.data.profilePhotoPath is string);
    }

    function validSubmittedProfile() {
      return request.resource.data.fullName.size() > 0
        && request.resource.data.phone.size() > 0
        && request.resource.data.programme.size() > 0
        && request.resource.data.hostelId.size() > 0
        && request.resource.data.room.size() > 0
        && validStudentHostel(request.resource.data.hostelId);
    }

    function validAdminProfileEdit() {
      return request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.programme is string
        && request.resource.data.hostelId is string
        && validStudentHostel(request.resource.data.hostelId)
        && request.resource.data.hostelName is string
        && request.resource.data.room is string;
    }

    // Emergency contacts: exactly two records with string fields.
    function validEmergencyData(studentUid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'studentEmail', 'contacts', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.uid == studentUid
        && request.resource.data.contacts is list
        && request.resource.data.contacts.size() == 2
        && request.resource.data.contacts[0].keys().hasOnly(['fullName', 'phone', 'relationship', 'address'])
        && request.resource.data.contacts[1].keys().hasOnly(['fullName', 'phone', 'relationship', 'address'])
        && request.resource.data.contacts[0].fullName is string
        && request.resource.data.contacts[0].phone is string
        && request.resource.data.contacts[0].relationship is string
        && request.resource.data.contacts[0].address is string
        && request.resource.data.contacts[1].fullName is string
        && request.resource.data.contacts[1].phone is string
        && request.resource.data.contacts[1].relationship is string
        && request.resource.data.contacts[1].address is string;
    }

    function completeEmergencyContacts(contacts) {
      return contacts is list
        && contacts.size() == 2
        && contacts[0].fullName is string && contacts[0].fullName.size() > 0
        && contacts[0].phone is string && contacts[0].phone.size() > 0
        && contacts[0].relationship is string && contacts[0].relationship.size() > 0
        && contacts[0].address is string && contacts[0].address.size() > 0
        && contacts[1].fullName is string && contacts[1].fullName.size() > 0
        && contacts[1].phone is string && contacts[1].phone.size() > 0
        && contacts[1].relationship is string && contacts[1].relationship.size() > 0
        && contacts[1].address is string && contacts[1].address.size() > 0;
    }

    function completeEmergencyContactsAfter(studentUid) {
      return existsAfter(/databases/$(database)/documents/emergencyContacts/$(studentUid))
        && completeEmergencyContacts(
          getAfter(/databases/$(database)/documents/emergencyContacts/$(studentUid)).data.contacts
        );
    }

    // Approved users
    match /approvedUsers/{userEmail} {
      allow read: if isSuperAdmin()
        || (signedIn() && email() == userEmail)
        || (isAdmin() && resource.data.role == 'admin'
          && resource.data.status == 'active'
          && resource.data.hostelIds is list
          && resource.data.hostelIds.hasAny(userData(request.auth.uid).hostelIds));

      allow create, update: if isSuperAdmin()
        && userEmail.matches('^[^@]+@[^@]+\\.[^@]+$')
        && validApprovedUser();

      allow delete: if isSuperAdmin();
    }

    // User accounts
    match /users/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (
            isSuperAdmin()
            && request.resource.data.role == 'superadmin'
            && request.resource.data.status == 'active'
          )
          || (
            isApprovedEmail(email())
            && request.resource.data.role == get(approvedPath(email())).data.role
            && request.resource.data.status == 'active'
            && request.resource.data.hostelIds == get(approvedPath(email())).data.hostelIds
          )
        );

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'lastLoginAt', 'hostelIds'
          ])
          && request.resource.data.hostelIds == get(approvedPath(email())).data.hostelIds
        );

      allow delete: if isSuperAdmin();
    }

    // Hostel master data and room capacity
    function validHostelData() {
      return request.resource.data.keys().hasOnly([
          'name', 'status', 'roomCount', 'capacityPerRoom', 'totalCapacity',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.roomCount is int
        && request.resource.data.roomCount > 0
        && request.resource.data.capacityPerRoom is int
        && request.resource.data.capacityPerRoom > 0
        && request.resource.data.totalCapacity == request.resource.data.roomCount * request.resource.data.capacityPerRoom;
    }

    match /hostels/{hostelId} {
      allow read: if isSuperAdmin()
        || (isActiveUser() && resource.data.status == 'active');

      allow create: if isSuperAdmin() && validHostelData();
      allow update: if isSuperAdmin() && validHostelData();
      allow delete: if isSuperAdmin();
    }

    // Student profiles
    match /studentProfiles/{studentUid} {
      // Queryable read scope: Admin may list only profiles whose hostelId
      // is one of the hostels assigned to the signed-in Admin.
      allow read: if signedIn() && (
        request.auth.uid == studentUid
        || isSuperAdmin()
        || (
          isAdmin()
          && resource.data.hostelId is string
          && resource.data.hostelId in userData(request.auth.uid).hostelIds
        )
      );

      allow create: if (
          signedIn()
          && request.auth.uid == studentUid
          && isStudent()
          && validProfileShape(studentUid)
          && request.resource.data.approvalStatus in ['draft', 'pending']
          && (
            request.resource.data.approvalStatus == 'draft'
            || (validSubmittedProfile() && completeEmergencyContactsAfter(studentUid))
          )
          && !('approvedBy' in request.resource.data)
          && !('approvedAt' in request.resource.data)
        )
        || (
          isSuperAdmin()
          && request.resource.data.uid == studentUid
          && request.resource.data.email is string
          && validAdminProfileEdit()
        );

      allow update: if (
          signedIn()
          && request.auth.uid == studentUid
          && isStudent()
          && resource.data.approvalStatus != 'pending'
          && validProfileShape(studentUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'programme', 'hostelId', 'hostelName', 'room',
            'updatedAt', 'approvalStatus', 'rejectionReason', 'submittedAt',
            'submissionVersion'
          ])
          && request.resource.data.approvalStatus in ['draft', 'pending', 'rejected']
          && (
            request.resource.data.approvalStatus != 'pending'
            || (
              validSubmittedProfile()
              && completeEmergencyContactsAfter(studentUid)
            )
          )
        )
        || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'programme', 'hostelId', 'hostelName', 'room',
            'updatedAt', 'lastEditedBy'
          ])
          && validAdminProfileEdit()
        )
        || (
          isAdmin()
          && assignedToHostel(resource.data.hostelId)
          && assignedToHostel(request.resource.data.hostelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'programme', 'hostelId', 'hostelName', 'room',
            'updatedAt', 'lastEditedBy'
          ])
          && validAdminProfileEdit()
        )
        || (
          (isSuperAdmin() || (isAdmin() && assignedToHostel(resource.data.hostelId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvalStatus', 'approvedBy', 'approvedByEmail', 'approvedAt',
            'rejectionReason', 'updatedAt'
          ])
          && request.resource.data.approvalStatus in ['approved', 'rejected']
          && (
            request.resource.data.approvalStatus != 'rejected'
            || (
              request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() > 0
            )
          )
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedByEmail == request.auth.token.email
        );

      allow delete: if isSuperAdmin();
    }

    // Soft-deleted student profiles: Super Admin only.
    match /deletedStudentProfiles/{studentUid} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // Emergency contacts
    match /emergencyContacts/{studentUid} {
      allow read: if canReadStudentRecord(studentUid);

      allow create, update: if (
          signedIn()
          && request.auth.uid == studentUid
          && isStudent()
          && validEmergencyData(studentUid)
          && (
            !exists(/databases/$(database)/documents/studentProfiles/$(studentUid))
            || get(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.approvalStatus != 'pending'
          )
          && getAfter(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.approvalStatus
            in ['draft', 'pending', 'rejected']
        )
        || (
          (isSuperAdmin() || (
            isAdmin()
            && exists(/databases/$(database)/documents/studentProfiles/$(studentUid))
            && assignedToHostel(
              get(/databases/$(database)/documents/studentProfiles/$(studentUid)).data.hostelId
            )
          ))
          && validEmergencyData(studentUid)
          && completeEmergencyContacts(request.resource.data.contacts)
        );

      allow delete: if isSuperAdmin();
    }

    // Immutable student activity logs
    match /studentActivityLogs/{logId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.studentUid
        || isSuperAdmin()
        || (isAdmin() && resource.data.hostelId in userData(request.auth.uid).hostelIds)
      );

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'studentUid', 'studentEmail', 'hostelId', 'action', 'details',
          'performedBy', 'performedByEmail', 'createdAt'
        ])
        && request.resource.data.studentUid is string
        && request.resource.data.action is string
        && request.resource.data.details is map
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == request.auth.token.email
        && (
          (isStudent() && request.resource.data.studentUid == request.auth.uid)
          || isSuperAdmin()
          || (
            isAdmin()
            && assignedToHostel(request.resource.data.hostelId)
            && exists(/databases/$(database)/documents/studentProfiles/$(request.resource.data.studentUid))
            && get(/databases/$(database)/documents/studentProfiles/$(request.resource.data.studentUid)).data.hostelId
              == request.resource.data.hostelId
          )
        );

      allow update, delete: if false;
    }

    // Immutable admin audit logs
    match /adminAuditLogs/{logId} {
      allow read: if isSuperAdmin();

      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          'action', 'targetEmail', 'oldRole', 'newRole', 'reason',
          'performedBy', 'performedByEmail', 'createdAt'
        ])
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    // Immutable student approval logs
    match /studentApprovalLogs/{logId} {
      allow read: if isSuperAdmin()
        || (isAdmin() && resource.data.hostelId in userData(request.auth.uid).hostelIds);

      allow create: if (
          isSuperAdmin()
          || (
            isAdmin()
            && request.resource.data.hostelId is string
            && assignedToHostel(request.resource.data.hostelId)
          )
        )
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByEmail == request.auth.token.email
        && request.resource.data.action in ['STUDENT_APPROVED', 'STUDENT_REJECTED'];

      allow update, delete: if false;
    }

    // Deny everything not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}