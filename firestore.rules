rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isSuper() {
      return signedIn() && request.auth.token.email_verified == true
        && email() == 'mhybsi91@gmail.com';
    }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() {
      return isSuper() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin' && userDoc().status == 'active');
    }

    // Senarai emel dibenarkan: hanya Super Admin boleh ubah.
    match /approvedUsers/{id} {
      allow read: if signedIn() && (id == email() || isAdmin());
      allow write: if isSuper();
    }

    // Profil pengguna: peranan hanya boleh ditetapkan semasa cipta (ikut senarai dibenarkan)
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.status == 'active'
        && (
          (isSuper() && request.resource.data.role == 'superadmin')
          || (exists(/databases/$(database)/documents/approvedUsers/$(email()))
              && request.resource.data.role ==
                 get(/databases/$(database)/documents/approvedUsers/$(email())).data.role
              && request.resource.data.role in ['student', 'admin'])
        );
      allow update: if isSuper()
        || (signedIn() && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'lastLoginAt']));
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
